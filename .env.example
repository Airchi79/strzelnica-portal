# Skopiuj do .env i uzupełnij. Pliku .env NIGDY nie dodawaj do repozytorium.
DJANGO_SECRET_KEY=zmien-na-dlugi-losowy-ciag
# Adres strony (domena) — bez https://. Można dopisać po przecinku adres IP serwera w sieci domowej.
DJANGO_ALLOWED_HOSTS=rezerwacje.example.pl
DJANGO_CSRF_TRUSTED_ORIGINS=https://rezerwacje.example.pl
SITE_URL=https://rezerwacje.example.pl
# true, gdy aplikacja stoi za Cloudflare Tunnel / Nginx Proxy Manager (prawdziwy adres IP odwiedzającego)
TRUST_X_FORWARDED_FOR=true

# Port aplikacji na serwerze oraz użytkownik plików (Unraid: nobody=99, users=100; QNAP: wynik polecenia `id <użytkownik>`)
APP_PORT=8000
# Dostęp do aplikacji po adresie IP serwera z sieci domowej (domyślnie tylko z samego serwera; z internetu przez tunel):
# APP_BIND=0.0.0.0
PUID=99
PGID=100

POSTGRES_DB=satok
POSTGRES_USER=satok
# Hasło bazy ustawiane jest przy PIERWSZYM uruchomieniu — późniejsza zmiana tutaj nie zmienia hasła w bazie.
POSTGRES_PASSWORD=zmien-haslo-bazy

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.pl
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Port 587: EMAIL_USE_TLS=true. Port 465 (SSL, np. LH.pl): EMAIL_USE_SSL=true i EMAIL_USE_TLS=false.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Strzelnica Sątok <no-reply@example.pl>
# Alarm o błędach serwera (strona z błędem 500, błędy zapisane w logu, np. e-mail niewysłany po wszystkich próbach) — adres(y) po przecinku. Puste = tylko log.
ERROR_EMAIL=

# Tpay (Open API) — bez tych wartości płatności online są wyłączone
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
TPAY_SECURITY_CODE=
TPAY_SANDBOX=true

# Axepta BNP Paribas (docs/AXEPTA.md) — dane z panelu Axepta (sandbox: axepta.sandbox.bnpparibas.pl).
# Bez kompletu danych Axepta jest wyłączona. Klucze wpisuj poleceniem: sh deploy/ustaw-env.sh AXEPTA_API_TOKEN (itd.)
AXEPTA_MERCHANT_ID=
AXEPTA_SERVICE_ID=
AXEPTA_API_TOKEN=
AXEPTA_SERVICE_KEY=
AXEPTA_SANDBOX=true

# Operator NOWYCH płatności online: tpay albo axepta. Płatności rozpoczęte wcześniej kończą się i są zwracane u swojego
# operatora — po przełączeniu zostaw dane poprzedniego operatora do czasu rozliczenia jego płatności i zwrotów.
ONLINE_PAYMENTS_PROVIDER=tpay

# Tunel Cloudflare jako kontener (docker compose --profile tunel up -d). Token NIE trafia do repozytorium ani do czatu.
TUNNEL_TOKEN=

# Kopia testowa (docs/KOPIA-TESTOWA.md) — na produkcji zostaw zakomentowane. Skrypt deploy/kopia-testowa.sh ustawia je sam.
# SITE_ENVIRONMENT=test
# EMAIL_REDIRECT_TO=biuro@example.pl
# IMAGE_NAME=strzelnica-portal-test
