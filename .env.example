# Skopiuj do .env i uzupełnij. Pliku .env NIGDY nie dodawaj do repozytorium.
DJANGO_SECRET_KEY=zmien-na-dlugi-losowy-ciag
# Adres strony (domena) — bez https://. Można dopisać po przecinku adres IP serwera w sieci domowej.
DJANGO_ALLOWED_HOSTS=rezerwacje.example.pl
DJANGO_CSRF_TRUSTED_ORIGINS=https://rezerwacje.example.pl
SITE_URL=https://rezerwacje.example.pl
# true, gdy aplikacja stoi za Cloudflare Tunnel / Nginx Proxy Manager (prawdziwy adres IP odwiedzającego)
TRUST_X_FORWARDED_FOR=true

# Port aplikacji na serwerze oraz użytkownik plików (Unraid: nobody=99, users=100; QNAP: wynik polecenia `id <użytkownik>`)
APP_PORT=8000
PUID=99
PGID=100

POSTGRES_DB=satok
POSTGRES_USER=satok
# Hasło bazy ustawiane jest przy PIERWSZYM uruchomieniu — późniejsza zmiana tutaj nie zmienia hasła w bazie.
POSTGRES_PASSWORD=zmien-haslo-bazy

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.pl
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Port 587: EMAIL_USE_TLS=true. Port 465 (SSL, np. LH.pl): EMAIL_USE_SSL=true i EMAIL_USE_TLS=false.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Strzelnica Sątok <no-reply@example.pl>

# Tpay (Open API) — bez tych wartości płatności online są wyłączone
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
TPAY_SECURITY_CODE=
TPAY_SANDBOX=true

# Tunel Cloudflare jako kontener (docker compose --profile tunel up -d). Token NIE trafia do repozytorium ani do czatu.
TUNNEL_TOKEN=
