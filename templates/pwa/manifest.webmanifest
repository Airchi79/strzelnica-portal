{% load static %}{
  "name": "Strzelnica Sątok",
  "short_name": "Sątok",
  "lang": "pl",
  "start_url": "{% url 'core:dashboard' %}",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f5f1",
  "theme_color": "#2f5d3a",
  "icons": [
    {"src": "{{ BRAND.icon_192 }}", "sizes": "192x192", "type": "image/png"},
    {"src": "{{ BRAND.icon_512 }}", "sizes": "512x512", "type": "image/png"},
    {"src": "{{ BRAND.icon_maskable }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
